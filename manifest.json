{
	"name": "Humble New Tab Page - TBP Fork",
	"short_name": "HNTP - TBP",
	"version": "1.27.0",
	"minimum_chrome_version": "104",
	"manifest_version": 3,
	"description": "Redesigned new tab page featuring your bookmarks, most visited, and recently closed in a custom layout.",
	"icons": {
		"128": "icons/icon_128.png",
		"48": "icons/icon_48.png",
		"16": "icons/icon_16.png"
	},
	"permissions": [
		"bookmarks",
		"favicon",
		"topSites",
		"tabs",
		"fontSettings",
		"sessions",
		"alarms"
	],
	"optional_host_permissions": [
		"file:///"
	],
	"background": {
		"service_worker": "background.js",
		"scripts": ["bookmark-cache.js", "background.js"]
	},
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"options_ui": {
		"page": "newtab.html?options",
		"open_in_tab": true
	}
}
